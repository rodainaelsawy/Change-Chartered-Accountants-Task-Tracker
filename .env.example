# Postgres connection (your local database during development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_tracker

# Public URL of the app (used in emails and invitation links)
APP_URL=http://localhost:3000

# Secret for the reminders endpoint: GET /api/cron/reminders?key=...
CRON_SECRET=change-me

# Email (optional). Leave SMTP_HOST empty in development: emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Task Tracker <no-reply@example.com>"

# Key used to encrypt the companies' tax-portal passwords. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and NEVER change it after real data exists (old passwords could no longer be read).
ENCRYPTION_KEY=

# File storage for PDF attachments. Leave empty locally: files are saved in the .uploads/ folder.
# In production (Vercel) this is set automatically when you connect a private Blob store.
BLOB_READ_WRITE_TOKEN=
